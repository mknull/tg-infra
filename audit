#!/usr/bin/env python3
"""audit — query the job-triage audit trail.

Usage:
    ./audit [email|telegram] [--last N] [--since TS] [--today] [--content] [--verbose]

Without arguments, shows the last 3 entries from both pipelines.
Pass --help for full usage.
"""
import argparse
import json
import os
import sys
from datetime import datetime, timezone, timedelta

PROJECT = os.path.dirname(os.path.abspath(__file__))
STATE = os.path.join(PROJECT, "state")
AUDIT_DIR = os.path.join(STATE, "audit")

SOURCES = {"email": "email.jsonl", "telegram": "telegram.jsonl",
           "briefme": "agent.jsonl"}
FEEDBACK_FILE = os.path.join(STATE, "feedback.jsonl")
REF_MAP_FILE = os.path.join(STATE, "ref-map.jsonl")


def _cursor_files():
    """(label, filename) for each cursor. Telegram cursors are derived from
    channels.json so the names track the poller, which writes {username}-cursor."""
    cursors = [("email", "email-cursor")]
    try:
        with open(os.path.join(STATE, "channels.json")) as f:
            for ch in json.load(f)["channels"]:
                u = ch["username"]
                cursors.append((u, f"{u}-cursor"))
    except (FileNotFoundError, KeyError, json.JSONDecodeError):
        pass
    return cursors

# ── feedback ─────────────────────────────────────────────────────

def load_feedback():
    """Return dict mapping internal msg_id → list of reaction records."""
    ref_map = {}
    if os.path.exists(REF_MAP_FILE):
        with open(REF_MAP_FILE) as f:
            for line in f:
                if line.strip():
                    r = json.loads(line)
                    ref_map[r["tg_msg_id"]] = r["ref"]
    feedback = {}
    if os.path.exists(FEEDBACK_FILE):
        with open(FEEDBACK_FILE) as f:
            for line in f:
                if line.strip():
                    fb = json.loads(line)
                    tg_id = fb["tg_msg_id"]
                    ref = ref_map.get(tg_id, tg_id)
                    feedback.setdefault(ref, []).append(fb)
    return feedback

# ── rendering ───────────────────────────────────────────────────

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"

DECISION_COLORS = {
    "send": GREEN, "flag": YELLOW, "read": CYAN, "relevant": YELLOW,
    "skip": DIM, "irrelevant": DIM,
    "error": RED, "dead_letter": RED, "next": DIM,
}


def color_decision(d):
    c = DECISION_COLORS.get(d, "")
    return f"{c}{d}{RESET}" if c else d


def is_dead_letter(r):
    """A record sealed WITHOUT a real evaluation — a transient/model error that
    was retired as terminal instead of retried (DEAD-LETTER, bug-hunt).

    Detected by substance, not just the honest "dead_letter" label, so it also
    catches the historical records that forged a "skip" at the top level while
    the error lives only in the flash window — plus a Pro error on a flagged
    message (evaluated as far as Flash, then sealed un-evaluated by Pro).
    """
    flash = r.get("flash", {})
    if flash.get("decision") == "dead_letter":
        return True
    if any(w.get("decision") == "error" for w in flash.get("windows", [])):
        return True
    if r.get("pro", {}).get("decision") == "error":
        return True
    return False


def fmt_ts(ts):
    """Human-friendly timestamp."""
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.strftime("%b %d %H:%M")
    except ValueError:
        return ts


def print_record(r, feedback=None, show_content=False, verbose=False):
    """Print a single audit record, omitting body by default."""
    source = r.get("source", "?")
    sender = r.get("sender", "?")
    preview = r.get("preview", "?")
    arrived = r.get("arrived_at", "?")
    msg_id = r.get("msg_id", "?")
    stage = r.get("stage", "")
    pro_decision = r.get("pro", {}).get("decision")

    # Agent (briefme) records use a different schema
    if source == "briefme" or "turns" in r:
        success = r.get("success", False)
        error = r.get("error")
        turns = r.get("turns", 0)
        tool_calls = r.get("tool_calls", [])
        tool_errors = r.get("tool_errors", 0)
        brief_bytes = r.get("brief_bytes", 0)
        duration = r.get("duration_s", 0)

        status = GREEN if success else RED
        print(f"{BOLD}{fmt_ts(arrived)}  briefme  {sender}{RESET}")
        print(f"  {preview}")
        print(f"  {turns} turns, {len(tool_calls)} tools, "
              f"{tool_errors} errors, {brief_bytes}B brief, "
              f"{status}{duration}s{RESET}")
        if error:
            print(f"  {RED}error: {error}{RESET}")
        if tool_calls and (verbose or show_content or tool_errors):
            for tc in tool_calls:
                tc_status = GREEN if tc["ok"] else RED
                args_str = json.dumps(tc.get("args", {}))
                if len(args_str) > 80:
                    args_str = args_str[:77] + "..."
                print(f"  {DIM}{tc['tool']}{RESET}({args_str}) "
                      f"→ {tc_status}{tc['result_bytes']}B{RESET} "
                      f"{DIM}{tc['duration_ms']}ms{RESET}")
        print()
        return

    print(f"{BOLD}{fmt_ts(arrived)}  {source}  {sender}{RESET}")
    print(f"  {preview}")
    if stage:
        print(f"  stage: {stage}")

    for label, key in [("flash", "flash"), ("pro", "pro")]:
        decision = r.get(key)
        if not decision:
            continue
        dec = decision.get("decision", "?")
        reason = decision.get("reason", "")
        dec_at = decision.get("at", "")
        model = decision.get("model", "")
        windows = decision.get("windows", [])

        line_info = ""
        if windows:
            # New format: show window summary
            wins = len(windows)
            last_w = windows[-1]
            line_info = f" {wins} windows ("
            parts = []
            for w in windows:
                parts.append(f"{color_decision(w['decision'])}")
            line_info += "→".join(parts)
            line_info += f", lines 1-{last_w['window_end']}/{last_w['total_lines']})"
        elif "line" in decision:
            # Legacy format
            line_info = f" line {decision['line']}/{decision.get('of','?')}"
        meta_parts = []
        if model:
            meta_parts.append(model)
        if dec_at:
            meta_parts.append(fmt_ts(dec_at))
        meta = f" ({', '.join(meta_parts)})" if meta_parts else ""
        print(f"  {label}: {color_decision(dec)}{line_info}{meta}")
        if reason:
            print(f"    {DIM}{reason}{RESET}")

    # Feedback
    if feedback and pro_decision == "send":
        for fb in feedback:
            rxns = " ".join(fb.get("reactions", []))
            fb_at = fmt_ts(fb.get("at", ""))
            if "👍" in rxns:
                tag = f"{GREEN}confirmed{RESET}"
            elif "👎" in rxns:
                tag = f"{RED}corrected{RESET}"
            else:
                tag = rxns
            print(f"  feedback: {tag} ({rxns} at {fb_at})")

    if show_content and "content" in r:
        body = r["content"]
        print(f"  {BOLD}body:{RESET} ({len(body)} chars)")
        if not verbose:
            body = body[:500] + ("..." if len(body) > 500 else "")
        print(f"    {DIM}{body}{RESET}")

    print()


def print_summary(records, label, feedback=None):
    """Print aggregate stats for a set of records."""
    if not records:
        print(f"{label}: no records\n")
        return

    total = len(records)
    unique = len(set(r.get("msg_id", i) for i, r in enumerate(records)))
    decisions = {}
    for r in records:
        for stage in ("flash", "pro"):
            if stage in r:
                d = r[stage]["decision"]
                decisions.setdefault(stage, {}).setdefault(d, 0)
                decisions[stage][d] += 1

    sends = [r for r in records if "pro" in r and r["pro"]["decision"] == "send"]
    errors = [r for r in records if ("flash" in r and r["flash"]["decision"] == "error")
              or ("pro" in r and r["pro"]["decision"] == "error")]
    # DEAD-LETTER (bug-hunt): a non-evaluation (transient/model error) sealed as
    # terminal. Surface it so we know what's dead-lettering, per pipeline.
    dead = [r for r in records if is_dead_letter(r)]

    print(f"{BOLD}{label}{RESET}: {total} records, {unique} unique messages")
    for stage, counts in decisions.items():
        parts = "  ".join(f"{color_decision(k)}:{v}" for k, v in sorted(counts.items()))
        print(f"  {stage}: {parts}")
    if sends:
        print(f"  {GREEN}sends: {len(sends)}{RESET}")
    if errors:
        print(f"  {RED}errors: {len(errors)}{RESET}")
    if dead:
        print(f"  {RED}dead-letters: {len(dead)}{RESET}")

    # feedback stats for this source's sends
    if feedback and sends:
        fb_sends = 0
        fb_confirmed = 0
        fb_corrected = 0
        for r in sends:
            fb_list = feedback.get(r.get("msg_id", ""))
            if fb_list:
                fb_sends += 1
                for fb in fb_list:
                    rxns = " ".join(fb.get("reactions", []))
                    if "👍" in rxns:
                        fb_confirmed += 1
                    elif "👎" in rxns:
                        fb_corrected += 1
        if fb_sends:
            total_fb = fb_confirmed + fb_corrected
            print(f"  feedback: {total_fb} reactions on {fb_sends}/{len(sends)} sends "
                  f"({GREEN}{fb_confirmed} confirmed{RESET}, {RED}{fb_corrected} corrected{RESET})")
    print()


# ── filtering ───────────────────────────────────────────────────

def load_records(source, since=None, last=None, today=False):
    """Load records from source, filtered by time window or count."""
    path = os.path.join(AUDIT_DIR, SOURCES[source])
    if not os.path.exists(path):
        return []
    with open(path) as f:
        records = [json.loads(l) for l in f if l.strip()]

    if today:
        today_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        records = [r for r in records
                   if (r.get("arrived_at", "")[:10] == today_str
                       or r.get("flash", {}).get("at", "")[:10] == today_str
                       or r.get("pro", {}).get("at", "")[:10] == today_str)]

    if since:
        records = [r for r in records
                   if (r.get("arrived_at", "") >= since
                       or r.get("flash", {}).get("at", "") >= since
                       or r.get("pro", {}).get("at", "") >= since)]

    if last:
        records = records[-last:]

    return records


def count_duplicates(records):
    """Return (unique_count, duplicate_count) for a list of audit records."""
    from collections import Counter
    msg_ids = [r["msg_id"] for r in records]
    counts = Counter(msg_ids)
    unique = len(counts)
    dupes = sum(1 for v in counts.values() if v > 1)
    wasted = sum(v - 1 for v in counts.values() if v > 1)
    return unique, dupes, wasted


def load_all(since=None, last=None, today=False):
    """Load from both sources, interleaved by arrival time."""
    records = []
    for src in SOURCES:
        records.extend(load_records(src, since=since, last=None, today=today))
    records.sort(key=lambda r: r.get("arrived_at", ""))
    if last:
        records = records[-last:]
    return records


# ── topology ─────────────────────────────────────────────────────

# Expected cascade topologies per pipeline
EXPECTED = {
    "email": """
  Arrival ──▶ Flash(from+subject) ──read──▶ fetch body ──▶ Pro(full body) ──send──▶ Feedback
                                  │                          │
                                  └──skip                    └──skip""",
    "it_jobs_cyprus": """
  Arrival ──▶ Flash(batch, 18 lines) ──flag──▶ Pro(full body) ──send──▶ Feedback
                                     │                      │
                                     └──skip                └──skip""",
    "cyithr": """
  Arrival ──▶ Flash(line 1) ──next──▶ Flash(line 2) ──next──▶ ... ──relevant──▶ Pro(full body) ──send──▶ Feedback
                             │                │                     │                       │
                             └──irrelevant    └──irrelevant         └──irrelevant           └──skip""",
}


def build_cascades(records, since_days=None):
    """Group records by msg_id and reconstruct cascade paths.

    Returns a dict: {source: [{msg_id, source, sender, preview,
                               flash_decisions, pro_decision, pro_message,
                               eval_count, path_str, arrived_at}]}
    where path_str is a compact representation of the cascade, e.g.:
      "f:read→p:skip" (email flash read, pro skip)
      "f:skip" (flash skip, terminal)
      "f:next→f:next→f:relevant→p:send" (cyithr line-by-line)
    """
    from collections import defaultdict

    cutoff = None
    if since_days:
        cutoff = (datetime.now(timezone.utc)
                  .replace(hour=0, minute=0, second=0, microsecond=0)
                  .isoformat())

    by_msg = defaultdict(list)
    for r in records:
        arrived = r.get("arrived_at", "")
        if cutoff and arrived < cutoff:
            continue
        by_msg[r["msg_id"]].append(r)

    cascades = defaultdict(list)
    for msg_id, recs in by_msg.items():
        recs.sort(key=lambda r: r.get("flash", {}).get("at", "")
                   or r.get("pro", {}).get("at", "")
                   or r.get("arrived_at", ""))

        source = recs[0].get("source", "?")
        sender = recs[0].get("sender", "?")
        preview = recs[0].get("preview", "?")
        arrived_at = recs[0].get("arrived_at", "?")

        # Collect flash window decisions from the windows list (new format)
        # or from the legacy line/of fields (old format)
        flash_decs = []
        pro_dec = None
        pro_msg = None
        eval_batches = set()
        for r in recs:
            if "flash" in r:
                f = r["flash"]
                key = f.get("at", "")
                if key:
                    eval_batches.add(key[:16])
                windows = f.get("windows", [])
                if windows:
                    # New format: flash_incremental windows list
                    for w in windows:
                        flash_decs.append({
                            "decision": w.get("decision", "?"),
                            "line": w.get("window_start"),
                            "of": w.get("total_lines"),
                            "reason": w.get("reason", ""),
                            "model": f.get("model", ""),
                            "at": f.get("at", ""),
                        })
                else:
                    # Legacy format: single flash decision
                    flash_decs.append({
                        "decision": f.get("decision", "?"),
                        "line": f.get("line"),
                        "of": f.get("of"),
                        "reason": f.get("reason", ""),
                        "model": f.get("model", ""),
                        "at": f.get("at", ""),
                    })
            if "pro" in r:
                p = r["pro"]
                pro_dec = {
                    "decision": p.get("decision", "?"),
                    "reason": p.get("reason", ""),
                    "model": p.get("model", ""),
                    "at": p.get("at", ""),
                }
                pro_msg = p.get("message")

        # Build compact path string
        path_parts = []
        for fd in flash_decs:
            d = fd["decision"]
            if d == "next":
                path_parts.append(f"f:{d}")
            else:
                path_parts.append(f"f:{d}")
                break  # terminal flash decision
        if pro_dec:
            path_parts.append(f"p:{pro_dec['decision']}")

        path_str = "→".join(path_parts) if path_parts else "arrival"

        cascades[source].append({
            "msg_id": msg_id,
            "source": source,
            "sender": sender,
            "preview": preview,
            "arrived_at": arrived_at,
            "flash_decisions": flash_decs,
            "pro_decision": pro_dec,
            "pro_message": pro_msg,
            "eval_count": len(eval_batches),
            "path_str": path_str,
        })

    return cascades


def print_topology(cascades, source, feedback, days):
    """Print expected vs actual topology for a pipeline."""
    entries = cascades.get(source, [])
    if not entries:
        print(f"{source}: no data in window\n")
        return

    total = len(entries)
    unique = len(set(e["msg_id"] for e in entries))

    # Count path frequencies
    from collections import Counter
    path_counts = Counter(e["path_str"] for e in entries)

    # Cascade stats
    flash_terminals = sum(1 for e in entries
                          if e["path_str"].startswith("f:") and "→p:" not in e["path_str"])
    pro_evals = sum(1 for e in entries if e["pro_decision"])
    sends = [e for e in entries
             if e["pro_decision"] and e["pro_decision"]["decision"] == "send"]
    duplicates = [e for e in entries if e["eval_count"] > 1]

    # Feedback linkage
    fb_linked = 0
    fb_confirmed = 0
    fb_corrected = 0
    for e in sends:
        fb_list = feedback.get(e["msg_id"], [])
        if fb_list:
            fb_linked += 1
            for fb in fb_list:
                rxns = " ".join(fb.get("reactions", []))
                if "👍" in rxns:
                    fb_confirmed += 1
                elif "👎" in rxns:
                    fb_corrected += 1

    print(f"{BOLD}══ {source} topology  "
          f"({total} messages, {days}d window){RESET}\n")

    # Expected
    exp = EXPECTED.get(source, EXPECTED.get("it_jobs_cyprus", ""))
    print(f"{DIM}Expected:{RESET}")
    print(exp)
    print()

    # Actual tree
    print(f"{DIM}Actual:{RESET}")
    print(f"  Arrival ({total})")
    for path, count in path_counts.most_common():
        pct = count / total * 100
        bar = "█" * max(1, int(pct / 5))
        print(f"    ├──▶ {path}  {count} ({pct:.0f}%) {DIM}{bar}{RESET}")
    print()

    # Node-level detail
    print(f"{DIM}Nodes:{RESET}")
    print(f"  Flash terminal (no Pro): {flash_terminals} ({flash_terminals/total*100:.0f}%)")
    print(f"  Pro evaluations:         {pro_evals} ({pro_evals/total*100:.0f}%)")
    print(f"  Pro sends:               {len(sends)}")
    if sends:
        print(f"  Feedback linked:         {fb_linked}/{len(sends)} sends"
              f" ({GREEN}{fb_confirmed} confirmed{RESET},"
              f" {RED}{fb_corrected} corrected{RESET})")
    if source == "cyithr":
        lines = [len([fd for fd in e["flash_decisions"] if fd["decision"] == "next"]) + 1
                 for e in entries]
        if lines:
            avg_lines = sum(lines) / len(lines)
            print(f"  Lines read (avg):        {avg_lines:.1f}")
            print(f"  Lines read (max):        {max(lines)}")
    print()

    # Deviations
    deviations = []
    if duplicates:
        n = len(duplicates)
        wasted = sum(e["eval_count"] - 1 for e in duplicates)
        deviations.append(
            f"{RED}DUPLICATE EVALS{RESET}: {n}/{total} messages re-evaluated "
            f"({wasted} wasted calls)")
    if source == "email":
        # Check for Pro called after Flash skip (shouldn't happen)
        weird = [e for e in entries
                 if any(fd["decision"] == "skip" for fd in e["flash_decisions"])
                 and e["pro_decision"]]
        if weird:
            deviations.append(
                f"{RED}BROKEN CASCADE{RESET}: {len(weird)} messages with "
                f"flash:skip→pro called (Pro should not run after Flash skip)")
        # Flash read rate
        flash_reads = sum(1 for e in entries
                         if any(fd["decision"] == "read" for fd in e["flash_decisions"]))
        if flash_reads / total > 0.7 and len(sends) == 0:
            deviations.append(
                f"{YELLOW}FLASH TOO BROAD{RESET}: {flash_reads}/{total} ({flash_reads/total*100:.0f}%) "
                f"read — but Pro sends 0. Flash costs money, adds nothing.")
    if source == "it_jobs_cyprus":
        pending = [e for e in entries if e["path_str"] == "arrival"]
        if pending:
            deviations.append(
                f"{YELLOW}STALLED{RESET}: {len(pending)} messages at arrival, not yet triaged")
        flags = sum(1 for e in entries
                   if any(fd["decision"] == "flag" for fd in e["flash_decisions"]))
        if flags > 0 and len(sends) == 0:
            deviations.append(
                f"{YELLOW}FLASH↛PRO MISMATCH{RESET}: Flash flagged {flags}, Pro sent 0 "
                f"— Flash filter is either wasting Pro calls or Pro is too strict")
    if source == "cyithr":
        irrelevant = sum(1 for e in entries
                        if any(fd["decision"] == "irrelevant"
                               for fd in e["flash_decisions"]))
        if irrelevant == total and total > 0:
            deviations.append(
                f"{YELLOW}ZERO PASS{RESET}: Flash rejected all {total} messages "
                f"— criteria may be too strict or channel has no relevant content")

    if deviations:
        print(f"{BOLD}Deviations:{RESET}")
        for d in deviations:
            print(f"  {d}")
        print()
    else:
        print(f"{GREEN}No deviations detected.{RESET}\n")


# ── main ────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(
        prog="audit",
        description="Query the job-triage audit trail.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  ./audit                     last 3 from both pipelines
  ./audit email               last 3 email decisions
  ./audit --today             everything from today
  ./audit email --since 2026-05-18   email since midnight UTC
  ./audit --last 10           last 10 records
  ./audit --summary           aggregate stats only
  ./audit --topology          cascade topology (7d window)
  ./audit --topology --days 3 cascade topology (3d window)
  ./audit email --content     include full bodies""",
    )
    p.add_argument("source", nargs="?", choices=["email", "telegram", "briefme"],
                   help="pipeline to query (default: all)")
    p.add_argument("--last", "-n", type=int, default=3,
                   help="show last N records (default: 3)")
    p.add_argument("--since", metavar="TS",
                   help="filter to records at or after timestamp (ISO 8601)")
    p.add_argument("--today", action="store_true",
                   help="show today's records (overrides --last)")
    p.add_argument("--content", "-c", action="store_true",
                   help="include message bodies")
    p.add_argument("--summary", "-s", action="store_true",
                   help="show aggregate stats only")
    p.add_argument("--verbose", "-v", action="store_true",
                   help="show full bodies and extra fields")
    p.add_argument("--topology", "-t", action="store_true",
                   help="show cascade topology (expected vs actual)")
    p.add_argument("--days", "-d", type=int, default=7,
                   help="window in days for topology (default: 7)")
    p.add_argument("--health", action="store_true",
                   help="exit 1 if duplicates, broken cascades, or stalled cursors found")
    args = p.parse_args()

    if args.today or args.summary or args.topology or args.health:
        args.last = None

    feedback = load_feedback()

    if args.health:
        # Short-window scan — exit non-zero if anything is wrong.
        exit_code = 0
        days = args.days if ('--days' in sys.argv or '-d' in sys.argv) else 1
        since = (datetime.now(timezone.utc) - timedelta(days=days)).isoformat()

        # --- direction health (source-independent) ---
        direction_file = os.path.join(STATE, "current-direction.md")
        small_file = os.path.join(STATE, "current-direction-small.md")
        dir_exists = os.path.exists(direction_file)
        small_exists = os.path.exists(small_file)
        if dir_exists != small_exists:
            print(f"{RED}DIRECTION MISMATCH{RESET}: one direction file exists "
                  f"without the other (full={dir_exists}, small={small_exists})")
            exit_code = 1
        if dir_exists and small_exists:
            dir_mtime = os.path.getmtime(direction_file)
            small_mtime = os.path.getmtime(small_file)
            dir_size = os.path.getsize(direction_file)
            small_size = os.path.getsize(small_file)
            if small_mtime < dir_mtime:
                print(f"{YELLOW}DIRECTION STALE COMPRESSION{RESET}: "
                      f"direction updated but small not recompressed")
                exit_code = 1
            if dir_size > 3000:
                print(f"{YELLOW}DIRECTION SIZE{RESET}: full direction {dir_size}B "
                      f"— may be accumulating stale preferences")
                exit_code = 1
            if small_size > 600:
                print(f"{YELLOW}DIRECTION COMPRESSION SIZE{RESET}: "
                      f"small direction {small_size}B — should be 1-2 sentences")
                exit_code = 1
            if small_mtime >= dir_mtime and dir_size <= 3000 and small_size <= 600:
                print(f"{GREEN}direction: clean{RESET}")
        else:
            print(f"{DIM}direction: no files{RESET}")

        # --- prompt size health ---
        for label, path in [("it-jobs-criteria", "it-jobs-criteria.md"),
                             ("email-triage-criteria", "email-triage-criteria.md")]:
            cpath = os.path.join(STATE, path)
            if os.path.exists(cpath):
                csize = os.path.getsize(cpath)
                if csize > 10000:
                    print(f"{RED}PROMPT SIZE{RESET}: {label} {csize}B "
                          f"— approaching context limit, prune rules")
                    exit_code = 1
                elif csize > 6000:
                    print(f"{YELLOW}PROMPT SIZE{RESET}: {label} {csize}B")
                else:
                    print(f"{GREEN}{label}: {csize}B{RESET}")

        # --- poller heartbeat ---
        heartbeat = os.path.join(STATE, "poller-heartbeat")
        if os.path.exists(heartbeat):
            try:
                hb_time = datetime.fromisoformat(
                    open(heartbeat).read().strip().replace("Z", "+00:00"))
                age_min = (datetime.now(timezone.utc) - hb_time).total_seconds() / 60
                if age_min > 60:
                    print(f"{RED}POLLER STALL{RESET}: last poll {age_min:.0f}min ago")
                    exit_code = 1
                else:
                    print(f"{GREEN}poller: {age_min:.0f}min ago{RESET}")
            except Exception:
                print(f"{YELLOW}poller: unreadable heartbeat{RESET}")
        else:
            print(f"{DIM}poller: no heartbeat yet{RESET}")

        # --- per-source cascade health ---
        for src in SOURCES:
            records = load_records(src, since=since)
            if src == "briefme":
                total = len(records)
                if total == 0:
                    print(f"{DIM}{src}: no data in window{RESET}")
                    continue
                failures = [r for r in records if not r.get("success")]
                zero_tools = [r for r in records
                             if r.get("success") and len(r.get("tool_calls", [])) == 0]
                high_errors = [r for r in records
                              if len(r.get("tool_calls", [])) > 0
                              and r.get("tool_errors", 0) / len(r["tool_calls"]) > 0.5]
                if failures:
                    print(f"{RED}BRIEFME FAILURES{RESET}: {len(failures)}/{total} "
                          f"briefs failed")
                    exit_code = 1
                if zero_tools:
                    print(f"{YELLOW}BRIEFME NO RESEARCH{RESET}: {len(zero_tools)}/{total} "
                          f"briefs used zero tools")
                    exit_code = 1
                if high_errors:
                    print(f"{RED}BRIEFME TOOL ERRORS{RESET}: {len(high_errors)}/{total} "
                          f"briefs with >50% tool failures")
                    exit_code = 1
                if not failures and not zero_tools and not high_errors:
                    print(f"{GREEN}{src}: clean{RESET}")
                continue

            unique, dupes, wasted = count_duplicates(records)
            # DEAD-LETTER (bug-hunt): surface non-evaluations sealed as terminal.
            # A flash/pro "dead_letter" decision means the message hit a
            # transient/model error and was never actually evaluated, yet was
            # retired and sealed in `seen`. Make it loud so we know what's
            # dead-lettering; the halt-and-resume fix that stops the loss is next.
            dead = [r for r in records if is_dead_letter(r)]
            if dead:
                print(f"{RED}DEAD-LETTERED{RESET} [{src}]: {len(dead)} message(s) hit a "
                      f"transient/model error and were sealed un-evaluated:")
                for r in dead[:5]:
                    reason = (r.get("flash", {}).get("reason")
                              or r.get("pro", {}).get("reason") or "?")
                    print(f"  {RED}✗{RESET} \"{r.get('preview','?')}\" from "
                          f"{r.get('sender','?')} ({reason})")
                exit_code = 1
            cascades = build_cascades(records)
            entries = cascades.get(src, [])
            if entries:
                total = len(entries)
                duplicates = [e for e in entries if e["eval_count"] > 1]
                weird = [e for e in entries
                         if any(fd["decision"] == "skip" for fd in e["flash_decisions"])
                         and e["pro_decision"]]
                if duplicates:
                    n = len(duplicates)
                    w = sum(e["eval_count"] - 1 for e in duplicates)
                    print(f"{RED}DUPLICATE EVALS{RESET} [{src}]: {n}/{total} messages "
                          f"re-evaluated ({w} wasted calls)")
                    exit_code = 1
                if weird:
                    print(f"{RED}BROKEN CASCADE{RESET} [{src}]: {len(weird)} messages "
                          f"with flash:skip→pro")
                    exit_code = 1
                if not duplicates and not weird and not dead:
                    print(f"{GREEN}{src}: clean{RESET}")
            elif not dead:
                print(f"{DIM}{src}: no data in window{RESET}")

        # --- dead-letter health (invariant: zero dead emails) ---
        deadletter_file = os.path.join(AUDIT_DIR, "dead-letter.jsonl")
        if os.path.exists(deadletter_file):
            dead = []
            with open(deadletter_file) as f:
                for line in f:
                    if line.strip():
                        r = json.loads(line)
                        if r.get("at", "") >= since:
                            dead.append(r)
            if dead:
                print(f"{RED}DEAD LETTERS{RESET}: {len(dead)} email(s) could not be "
                      f"processed and were dropped — this should never happen:")
                for r in dead:
                    print(f"  {RED}✗{RESET} \"{r.get('preview','?')}\" from "
                          f"{r.get('sender','?')} ({r.get('attempts','?')} attempts: "
                          f"{r.get('error','?')})")
                exit_code = 1
            else:
                print(f"{GREEN}dead-letters: none in window{RESET}")

        # --- delivery audit health ---
        delivery_file = os.path.join(AUDIT_DIR, "delivery.jsonl")
        if os.path.exists(delivery_file):
            delivery_records = []
            with open(delivery_file) as f:
                for line in f:
                    if line.strip():
                        r = json.loads(line)
                        if r.get("at", "") >= since:
                            delivery_records.append(r)
            if delivery_records:
                failures = [r for r in delivery_records if not r.get("success")]
                total_d = len(delivery_records)
                if failures:
                    channels = set(r.get("channel", "?") for r in failures)
                    print(f"{RED}DELIVERY FAILURES{RESET}: {len(failures)}/{total_d} "
                          f"failed ({', '.join(channels)})")
                    exit_code = 1
                else:
                    print(f"{GREEN}delivery: clean{RESET} "
                          f"({total_d} deliveries, {len(set(r['channel'] for r in delivery_records))} channels)")
            else:
                print(f"{DIM}delivery: no data in window{RESET}")
        else:
            print(f"{DIM}delivery: no file{RESET}")

        # --- canary health (synthetic delivery probe — real outcome) ---
        canary_status = os.path.join(STATE, "canary-status.json")
        if os.path.exists(canary_status):
            try:
                c = json.loads(open(canary_status).read())
                if c.get("ok"):
                    print(f"{GREEN}canary: delivering{RESET} (last run {c.get('at','?')})")
                else:
                    print(f"{RED}CANARY FAILED{RESET}: delivery is broken — "
                          f"{c.get('detail','?')} (last run {c.get('at','?')})")
                    exit_code = 1
            except Exception:
                print(f"{YELLOW}canary: unreadable status{RESET}")
        else:
            print(f"{DIM}canary: never run{RESET}")

        # --- weekly report health ---
        weekly_file = os.path.join(AUDIT_DIR, "weekly.jsonl")
        if os.path.exists(weekly_file):
            weekly_records = []
            with open(weekly_file) as f:
                for line in f:
                    if line.strip():
                        r = json.loads(line)
                        if r.get("report_at", "") >= since:
                            weekly_records.append(r)
            if weekly_records:
                failures = [r for r in weekly_records if not r.get("success")]
                if failures:
                    print(f"{RED}WEEKLY FAILURES{RESET}: {len(failures)} reports failed")
                    exit_code = 1
                else:
                    latest = weekly_records[-1]
                    print(f"{GREEN}weekly: clean{RESET} "
                          f"(last report {latest.get('report_at','?')[:10]}, "
                          f"{latest.get('tagged_count',0)} tagged, "
                          f"{latest.get('send_count',0)} sends)")
            else:
                print(f"{DIM}weekly: no data in window{RESET}")
        else:
            print(f"{DIM}weekly: no file{RESET}")

        sys.exit(exit_code)

    if args.topology:
        sources = [args.source] if args.source else list(SOURCES)
        sources = [s for s in sources if s != "briefme"]  # no cascade for agent
        if args.since:
            since = args.since
        else:
            since = (datetime.now(timezone.utc)
                     - timedelta(days=args.days)).isoformat()
        for src in sources:
            records = load_records(src, since=since)
            cascades = build_cascades(records)
            print_topology(cascades, src, feedback, args.days)
        # footer
        print(f"{DIM}── cursors{RESET}")
        for cursor_name, src in _cursor_files():
            cursor_path = os.path.join(STATE, src)
            if os.path.exists(cursor_path):
                val = open(cursor_path).read().strip()
                print(f"  {DIM}{cursor_name}: {val}{RESET}")
        return

    sources = [args.source] if args.source else list(SOURCES)

    for src in sources:
        records = load_records(src, since=args.since,
                               last=args.last, today=args.today)
        if args.summary:
            print_summary(records, src, feedback)
        else:
            unique, dupes, wasted = count_duplicates(records)
            src_label = f"{src} ({len(records)} records"
            if dupes:
                src_label += f", {BOLD}{RED}{dupes} msgs re-evaluated ({wasted} wasted calls){RESET}"
            src_label += ")"
            print(f"{BOLD}══ {src_label}{RESET}\n")
            if not records:
                print(f"  {DIM}no matching records{RESET}\n")
            for r in records:
                fb = feedback.get(r.get("msg_id", ""))
                print_record(r, feedback=fb, show_content=args.content,
                             verbose=args.verbose)

    if not args.summary:
        # cursors + feedback presence
        print(f"{DIM}── cursors{RESET}")
        for cursor_name, src in _cursor_files():
            cursor_path = os.path.join(STATE, src)
            if os.path.exists(cursor_path):
                val = open(cursor_path).read().strip()
                print(f"  {DIM}{cursor_name}: {val}{RESET}")
        if feedback:
            total = sum(len(v) for v in feedback.values())
            confirmed = sum(1 for v in feedback.values()
                           for fb in v if "👍" in " ".join(fb.get("reactions", [])))
            corrected = total - confirmed
            print(f"  {DIM}feedback: {total} reactions ({GREEN}{confirmed} confirmed{RESET}{DIM}, {RED}{corrected} corrected{RESET}{DIM}) for {len(feedback)} messages{RESET}")


if __name__ == "__main__":
    main()
