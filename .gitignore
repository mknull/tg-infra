# Runtime state — ALL of it. Tokens, sessions, cursors, queues, audit,
# logs, config. Ignore the whole tree, not file-by-file: enumerating
# risks silently tracking a new secret-bearing state file. Seed/example
# files live at the repo root (*.example), not under state/.
state/

# Generated output
workspace/

# Local-only content (de-authored repo; lives only on disk by design)
source/
skills/

# Virtualenv
jobsmcp/

# Python artifacts
__pycache__/
*.pyc
.coverage

# IDE / tooling
.idea/
.claude/
